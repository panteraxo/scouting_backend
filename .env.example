# ============================================================
# Scouting.pe - variables del backend (ejemplo, sin secretos)
# Copiar a backend/scouting/.env (no versionado) y completar:
#   docker build -t scouting .\backend\scouting
#   docker run --rm -p 9193:9193 --env-file backend/scouting/.env scouting
# ============================================================

# ------------------------------------------------------------
# Base de datos Aiven
# ------------------------------------------------------------
# Copia HOST y PORT exactos desde:
# Aiven > Servicio MySQL > Overview > Connection information
# Comprueba que el servicio este en estado Running.
DB_URL=jdbc:mysql://localhost:3306/scouting?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Si quieres probar ahora contra MySQL local en Docker Desktop,
# comenta las tres lineas anteriores y descomenta esta:
# DB_URL=jdbc:mysql://host.docker.internal:3306/scouting?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=MYSQL

# Primera ejecucion: update. Luego de verificar el esquema: validate.
JPA_DDL_AUTO=update

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=9193
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://scouting-frontend-ten.vercel.app
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax

# Para produccion usa el perfil prod, HTTPS y cookie segura:
# SPRING_PROFILES_ACTIVE=prod
# SESSION_COOKIE_SECURE=true
# APP_CORS_ALLOWED_ORIGINS=https://app.scouting.net.pe

# ------------------------------------------------------------
# Primer administrador (opcional)
# ------------------------------------------------------------
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
BOOTSTRAP_ADMIN_DOCUMENT_TYPE=DNI
BOOTSTRAP_ADMIN_DOCUMENT_NUMBER=
BOOTSTRAP_ADMIN_PHONE=


# ------------------------------------------------------------
# Cloudflare R2 - completar con las credenciales locales
# ------------------------------------------------------------
# El backend aun no consume estas variables hasta implementar SCP-019.
# Para pruebas con Docker se cargan desde este archivo mediante docker compose.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_BUCKET=scouting-public
R2_PRIVATE_BUCKET=scouting-private

R2_PUBLIC_BASE_URL=https://media.scouting.net.pe
R2_PRESIGN_TTL_SECONDS=900
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=